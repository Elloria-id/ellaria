# Database (Neon/Supabase)
DATABASE_URL=postgresql://user:pass@ep-cool-db.neon.tech/neondb?sslmode=require

# Authentication
NEXTAUTH_SECRET=your-secret-key-min-32-chars
NEXTAUTH_URL=https://your-app.vercel.app

# App
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Storage
STORAGE_PROVIDER=r2

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Supabase Realtime (Chat)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Payment Provider (manual, midtrans, xendit, tripay, duitku)
PAYMENT_PROVIDER=manual

# Manual QRIS (Fallback)
QRIS_IMAGE_URL=

# Midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# Xendit
XENDIT_API_KEY=

# Tripay
TRIPAY_BASE_URL=https://tripay.co.id/api-sandbox
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_CALLBACK_URL=
TRIPAY_RETURN_URL=

# Duitku
DUITKU_API_KEY=
DUITKU_MERCHANT_CODE=

# Redis (Caching)
REDIS_URL=

# Cron Jobs
CRON_SECRET=
