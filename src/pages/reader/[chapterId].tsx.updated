import { useState, useEffect } from 'react'
import { useRouter } from 'next/router'

export default function ReaderPage() {
  const router = useRouter()
  const { chapterId } = router.query
  const [chapter, setChapter] = useState<any>(null)
  const [prevId, setPrevId] = useState<string | null>(null)
  const [nextId, setNextId] = useState<string | null>(null)
  const [loading, setLoading] = useState(false)

  useEffect(() => {
    if (!chapterId) return
    setLoading(true)
    fetch(`/api/chapters/${chapterId}`).then(async (res) => {
      if (res.ok) {
        const data = await res.json()
        setChapter(data.chapter)
        setPrevId(data.prevId)
        setNextId(data.nextId)
        // preload next chapter images
        if (data.nextId) {
          fetch(`/api/chapters/${data.nextId}`).then(async (r2) => {
            if (r2.ok) {
              const d2 = await r2.json()
              d2.chapter.images?.forEach((src: string) => {
                const img = new Image()
                img.src = src
              })
            }
          })
        }
      }
      setLoading(false)
    })
  }, [chapterId])

  if (!chapterId) return null

  return (
    <div className="min-h-screen bg-gray-50 dark:bg-gray-900">
      <div className="max-w-3xl mx-auto p-4">
        <div className="flex items-center justify-between mb-4">
          <h1 className="text-lg font-semibold">{chapter?.title || 'Chapter'}</h1>
          <div className="flex gap-2">
            {prevId && <button onClick={() => router.push(`/reader/${prevId}`)} className="px-3 py-1 bg-gray-200 rounded">Prev</button>}
            {nextId && <button onClick={() => router.push(`/reader/${nextId}`)} className="px-3 py-1 bg-gray-200 rounded">Next</button>}
          </div>
        </div>

        {loading && <p>Loading...</p>}

        <div className="space-y-4">
          {chapter?.images?.map((src: string, idx: number) => (
            <img key={idx} src={src} loading="lazy" alt={`page-${idx + 1}`} className="w-full rounded" />
          ))}
        </div>
      </div>
    </div>
  )
}
